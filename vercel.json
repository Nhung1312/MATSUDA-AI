{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?path=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "fix/exam-review-storage-safety-20261023": false,
      "fix/manual-ai-grading-reliability-20261023": false
    }
  }
}
